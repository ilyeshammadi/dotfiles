#!/usr/bin/env bash
#
# ws - tmux sessions backed by git worktrees
#
# USAGE
#   ws create -p <profile> <task-id>        one tmux window + worktree per repo
#   ws delete -p <profile> [<task-id>...]   kill session, remove worktrees and branches
#                                           (no task-id: pick with fzf)
#   ws list                                 list tasks across all profiles
#
# PROFILE (~/.config/ws/profiles/<name>.sh)
#
#   WS_TREE_DIR   where worktrees go: $WS_TREE_DIR/<task-id>/<alias>
#   WS_REPOS      entries of "<repo-path>,from=<base>[,branch=<name>][,as=<alias>]"
#                   from    required, branch the worktree is created from
#                   branch  new branch name, {TASK} is replaced  (default: {TASK})
#                   as      worktree dir + tmux window name, {TASK} is replaced
#                           (default: basename of repo-path)
#   ws_post_<repo>()  optional, lines are typed into the repo's window after setup;
#                     <repo> is the basename of repo-path with - replaced by _
#
#   Example:
#     BASE=~/dev/myproject
#     WS_TREE_DIR=$BASE/tree
#     WS_REPOS=(
#       "$BASE/backend,from=main"
#       "$BASE/frontend,from=develop,branch=feature/{TASK},as=ui"
#     )
#     ws_post_frontend() {
#       npm install
#     }
#
set -euo pipefail

PROFILES_DIR="$HOME/.config/ws/profiles"

die() { echo "$*" >&2; exit 1; }

usage() {
  die "Usage:
  ws create -p <profile> <task-id>
  ws delete -p <profile> [<task-id>...]
  ws list"
}

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------

session_name() { echo "task-$1"; }
task_dir()     { echo "$WS_TREE_DIR/$1"; }

# parse_repo <entry> <task-id>
# Sets REPO_PATH, REPO_NAME, REPO_FROM, REPO_BRANCH, REPO_ALIAS, REPO_WORKTREE.
parse_repo() {
  local entry="$1" task="$2" opt
  local -a opts
  IFS=',' read -ra opts <<< "$entry"

  REPO_PATH="${opts[0]}"
  REPO_NAME="$(basename "$REPO_PATH")"
  REPO_FROM=""
  REPO_BRANCH="{TASK}"
  REPO_ALIAS="$REPO_NAME"

  for opt in "${opts[@]:1}"; do
    case "$opt" in
      from=*)   REPO_FROM="${opt#from=}" ;;
      branch=*) REPO_BRANCH="${opt#branch=}" ;;
      as=*)     REPO_ALIAS="${opt#as=}" ;;
      *)        die "Unknown option '$opt' in '$entry'" ;;
    esac
  done
  [[ -n "$REPO_FROM" ]] || die "Missing from=<branch> in '$entry'"

  REPO_BRANCH="${REPO_BRANCH//\{TASK\}/$task}"
  REPO_ALIAS="${REPO_ALIAS//\{TASK\}/$task}"
  REPO_WORKTREE="$(task_dir "$task")/$REPO_ALIAS"
}

load_profile() {
  local file="$PROFILES_DIR/$1.sh"
  [[ -f "$file" ]] || die "Profile not found: $file"
  source "$file"
}

# Lines of the profile's ws_post_<repo> function, empty if not defined.
# declare -f prints "name ()", "{", body..., "}" with trailing ";" on each line.
post_commands() {
  local fn="ws_post_${1//-/_}"
  declare -f "$fn" >/dev/null || return 0
  declare -f "$fn" | sed '1,2d;$d;s/^[[:space:]]*//;s/;$//;/^$/d'
}

# ---------------------------------------------------------------------------
# tmux
# ---------------------------------------------------------------------------

# open_window <session> <window> <is-first> [command]
# The first window creates the session.
open_window() {
  local session="$1" window="$2" first="$3"
  shift 3
  if [[ "$first" == true ]]; then
    tmux new-session -d -s "$session" -n "$window" "$@"
  else
    tmux new-window -t "$session" -n "$window" "$@"
  fi
}

type_line() { tmux send-keys -t "$1" "$2" Enter; }

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

# Sets PROFILE from -p and leaves the remaining args in ARGS.
parse_flags() {
  PROFILE=""
  ARGS=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -p) PROFILE="${2:-}"; shift 2 || usage ;;
      *)  ARGS+=("$1"); shift ;;
    esac
  done
  [[ -n "$PROFILE" ]] || usage
}

cmd_create() {
  parse_flags "$@"
  [[ ${#ARGS[@]} -eq 1 ]] || usage
  local task="${ARGS[0]}"
  load_profile "$PROFILE"

  local session first=true entry line
  session="$(session_name "$task")"
  mkdir -p "$(task_dir "$task")"

  for entry in "${WS_REPOS[@]}"; do
    parse_repo "$entry" "$task"
    echo "Setting up $REPO_NAME as $REPO_ALIAS (branch: $REPO_BRANCH, from: $REPO_FROM)..."

    open_window "$session" "$REPO_ALIAS" "$first"
    first=false
    local target="$session:$REPO_ALIAS"
    local git="git -C '$REPO_PATH'"

    type_line "$target" "$git checkout '$REPO_FROM' && $git pull && $git worktree add -b '$REPO_BRANCH' '$REPO_WORKTREE' '$REPO_FROM' 2>/dev/null; cd '$REPO_WORKTREE'"
    type_line "$target" "clear"
    while IFS= read -r line; do
      type_line "$target" "$line"
    done < <(post_commands "$REPO_NAME")
  done

  echo "Session '$session' created with profile '$PROFILE'."
  echo "Attach with: tmux attach -t $session"
}

cmd_delete() {
  parse_flags "$@"
  load_profile "$PROFILE"

  local task
  local -a tasks=("${ARGS[@]+"${ARGS[@]}"}")
  if [[ ${#tasks[@]} -eq 0 ]]; then
    while IFS= read -r task; do tasks+=("$task"); done < <(ls "$WS_TREE_DIR" 2>/dev/null | fzf -m || true)
    [[ ${#tasks[@]} -gt 0 ]] || { echo "Nothing selected."; return; }
  fi

  for task in "${tasks[@]}"; do
    delete_task "$task"
  done
}

# Removal runs in a detached "delete-task-<id>" session: one window per repo,
# plus a cleanup window that removes the task dir once the others have exited.
delete_task() {
  local task="$1" entry first=true
  local session="delete-$(session_name "$task")"

  tmux kill-session -t "$(session_name "$task")" 2>/dev/null || true

  for entry in "${WS_REPOS[@]}"; do
    parse_repo "$entry" "$task"
    local git="git -C '$REPO_PATH'"
    open_window "$session" "$REPO_ALIAS" "$first" \
      "bash -c \"$git worktree remove '$REPO_WORKTREE' 2>/dev/null; $git worktree prune; $git branch -D '$REPO_BRANCH' 2>/dev/null\""
    first=false
  done

  tmux new-window -t "$session" -n cleanup \
    "bash -c \"while tmux list-windows -t '$session' 2>/dev/null | grep -qv cleanup; do sleep 0.5; done; rm -rf '$(task_dir "$task")'; echo 'Deleted $task.'; sleep 2\""

  echo "Deleting '$task' in tmux session '$session'."
}

cmd_list() {
  local file
  for file in "$PROFILES_DIR"/*.sh; do
    [[ -f "$file" ]] || continue
    # Subshell so one profile's variables don't leak into the next.
    (
      source "$file"
      [[ -d "${WS_TREE_DIR:-}" ]] || exit 0
      for dir in "$WS_TREE_DIR"/*/; do
        if [[ -d "$dir" ]]; then
          printf "%-30s (profile: %s)\n" "$(basename "$dir")" "$(basename "$file" .sh)"
        fi
      done
    )
  done | sort -u
}

# ---------------------------------------------------------------------------

case "${1:-}" in
  create) shift; cmd_create "$@" ;;
  delete) shift; cmd_delete "$@" ;;
  list)   shift; cmd_list "$@" ;;
  *)      usage ;;
esac
