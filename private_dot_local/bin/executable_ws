#!/usr/bin/env bash
#
# ws - tmux sessions backed by git worktrees
#
# USAGE
#   ws add <task-id> [<alias>...]      one tmux window + worktree per chosen repo; adds to
#                                      the task's session if it already exists
#                                      (no alias: pick repos with fzf)
#   ws delete [<task-id>...]           kill session, remove worktrees and branches
#                                      (no task-id: pick tasks with fzf)
#   ws list                            list tasks and their repos
#   ws repos                           list configured repo aliases
#
# CONFIG (~/.config/ws/config.sh)
#
#   WS_TREE_DIR   where worktrees go: $WS_TREE_DIR/<task-id>/<alias>
#   WS_REPOS      entries of "<repo-path>,from=<base>[,branch=<name>][,as=<alias>]"
#                   from    required, branch the worktree is created from
#                   branch  new branch name, {TASK} is replaced  (default: {TASK})
#                   as      name used to select the repo, and the worktree dir +
#                           tmux window name (default: basename of repo-path)
#   ws_post_<repo>()  optional, lines are typed into the repo's window after setup;
#                     <repo> is the basename of repo-path with - replaced by _
#
#   Example:
#     BASE=~/dev/myproject
#     WS_TREE_DIR=$BASE/tree
#     WS_REPOS=(
#       "$BASE/backend,from=main"
#       "$BASE/frontend,from=develop,branch=feature/{TASK},as=ui"
#     )
#     ws_post_frontend() {
#       npm install
#     }
#
set -euo pipefail

CONFIG_FILE="${WS_CONFIG:-$HOME/.config/ws/config.sh}"

die() { echo "$*" >&2; exit 1; }

usage() {
  die "Usage:
  ws add <task-id> [<alias>...]
  ws delete [<task-id>...]
  ws list
  ws repos"
}

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------

session_name() { echo "task-$1"; }
task_dir()     { echo "$WS_TREE_DIR/$1"; }

load_config() {
  [[ -f "$CONFIG_FILE" ]] || die "Config not found: $CONFIG_FILE"
  source "$CONFIG_FILE"
}

# parse_repo <entry> <task-id>
# Sets REPO_PATH, REPO_NAME, REPO_FROM, REPO_BRANCH, REPO_ALIAS, REPO_WORKTREE.
parse_repo() {
  local entry="$1" task="$2" opt
  local -a opts
  IFS=',' read -ra opts <<< "$entry"

  REPO_PATH="${opts[0]}"
  REPO_NAME="$(basename "$REPO_PATH")"
  REPO_FROM=""
  REPO_BRANCH="{TASK}"
  REPO_ALIAS="$REPO_NAME"

  for opt in "${opts[@]:1}"; do
    case "$opt" in
      from=*)   REPO_FROM="${opt#from=}" ;;
      branch=*) REPO_BRANCH="${opt#branch=}" ;;
      as=*)     REPO_ALIAS="${opt#as=}" ;;
      *)        die "Unknown option '$opt' in '$entry'" ;;
    esac
  done
  [[ -n "$REPO_FROM" ]] || die "Missing from=<branch> in '$entry'"

  REPO_BRANCH="${REPO_BRANCH//\{TASK\}/$task}"
  REPO_ALIAS="${REPO_ALIAS//\{TASK\}/$task}"
  REPO_WORKTREE="$(task_dir "$task")/$REPO_ALIAS"
}

# Prints the WS_REPOS entry whose alias is <alias>, or fails.
find_repo() {
  local alias="$1" task="$2" entry
  for entry in "${WS_REPOS[@]}"; do
    parse_repo "$entry" "$task"
    if [[ "$REPO_ALIAS" == "$alias" ]]; then
      echo "$entry"
      return
    fi
  done
  die "Unknown repo '$alias' (see: ws repos)"
}

# Prints all configured aliases, one per line.
list_aliases() {
  local entry
  for entry in "${WS_REPOS[@]}"; do
    parse_repo "$entry" "{TASK}"
    echo "$REPO_ALIAS"
  done
}

# Lines of the config's ws_post_<repo> function, empty if not defined.
# declare -f prints "name ()", "{", body..., "}" with trailing ";" on each line.
post_commands() {
  local fn="ws_post_${1//-/_}"
  declare -f "$fn" >/dev/null || return 0
  declare -f "$fn" | sed '1,2d;$d;s/^[[:space:]]*//;s/;$//;/^$/d'
}

# ---------------------------------------------------------------------------
# tmux
# ---------------------------------------------------------------------------

# open_window <session> <window> <is-first> [command]
# The first window creates the session.
open_window() {
  local session="$1" window="$2" first="$3"
  shift 3
  if [[ "$first" == true ]]; then
    tmux new-session -d -s "$session" -n "$window" "$@"
  else
    tmux new-window -t "$session" -n "$window" "$@"
  fi
}

type_line() { tmux send-keys -t "$1" "$2" Enter; }

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_add() {
  [[ $# -ge 1 ]] || usage
  local task="$1"
  shift
  load_config

  local -a aliases=("$@") entries=()
  local alias entry line
  if [[ ${#aliases[@]} -eq 0 ]]; then
    while IFS= read -r alias; do aliases+=("$alias"); done < <(list_aliases | fzf -m --prompt "repos for $task> " || true)
    [[ ${#aliases[@]} -gt 0 ]] || die "No repo selected."
  fi
  # Resolve every alias before touching tmux, so a typo creates nothing.
  for alias in "${aliases[@]}"; do
    entry="$(find_repo "$alias" "$task")"
    entries+=("$entry")
  done

  local session first=true
  session="$(session_name "$task")"
  tmux has-session -t "=$session" 2>/dev/null && first=false
  mkdir -p "$(task_dir "$task")"

  for entry in "${entries[@]}"; do
    parse_repo "$entry" "$task"
    if [[ "$first" == false ]] && tmux list-windows -t "=$session" -F '#W' | grep -qxF "$REPO_ALIAS"; then
      echo "Skipping $REPO_ALIAS: already in $session."
      continue
    fi
    echo "Setting up $REPO_NAME as $REPO_ALIAS (branch: $REPO_BRANCH, from: $REPO_FROM)..."

    open_window "$session" "$REPO_ALIAS" "$first"
    first=false
    local target="$session:$REPO_ALIAS"
    local git="git -C '$REPO_PATH'"

    type_line "$target" "$git checkout '$REPO_FROM' && $git pull && $git worktree add -b '$REPO_BRANCH' '$REPO_WORKTREE' '$REPO_FROM' 2>/dev/null; cd '$REPO_WORKTREE'"
    type_line "$target" "clear"
    while IFS= read -r line; do
      type_line "$target" "$line"
    done < <(post_commands "$REPO_NAME")
  done

  echo "Session '$session' ready."
  echo "Attach with: tmux attach -t $session"
}

cmd_delete() {
  load_config

  local task
  local -a tasks=("$@")
  if [[ ${#tasks[@]} -eq 0 ]]; then
    while IFS= read -r task; do tasks+=("$task"); done < <(ls "$WS_TREE_DIR" 2>/dev/null | fzf -m || true)
    [[ ${#tasks[@]} -gt 0 ]] || { echo "Nothing selected."; return; }
  fi

  for task in "${tasks[@]}"; do
    delete_task "$task"
  done
}

# Removal runs in a detached "delete-task-<id>" session: one window per repo
# found in the task dir, plus a cleanup window that removes the task dir once
# the others have exited.
# shortcut: repos are matched by worktree dir against the current config, so a
# repo removed or re-aliased since create is left behind; store a manifest if that bites.
delete_task() {
  local task="$1" entry first=true
  local session="delete-$(session_name "$task")"

  tmux kill-session -t "$(session_name "$task")" 2>/dev/null || true

  for entry in "${WS_REPOS[@]}"; do
    parse_repo "$entry" "$task"
    [[ -d "$REPO_WORKTREE" ]] || continue
    local git="git -C '$REPO_PATH'"
    open_window "$session" "$REPO_ALIAS" "$first" \
      "bash -c \"$git worktree remove '$REPO_WORKTREE' 2>/dev/null; $git worktree prune; $git branch -D '$REPO_BRANCH' 2>/dev/null\""
    first=false
  done

  open_window "$session" cleanup "$first" \
    "bash -c \"while tmux list-windows -t '$session' 2>/dev/null | grep -qv cleanup; do sleep 0.5; done; rm -rf '$(task_dir "$task")'; echo 'Deleted $task.'; sleep 2\""

  echo "Deleting '$task' in tmux session '$session'."
}

cmd_list() {
  load_config
  local dir
  for dir in "$WS_TREE_DIR"/*/; do
    [[ -d "$dir" ]] || continue
    printf "%-30s %s\n" "$(basename "$dir")" "$(ls "$dir" | tr '\n' ' ')"
  done
}

cmd_repos() {
  load_config
  local entry
  for entry in "${WS_REPOS[@]}"; do
    parse_repo "$entry" "{TASK}"
    printf "%-12s %-40s from=%-10s branch=%s\n" "$REPO_ALIAS" "$REPO_PATH" "$REPO_FROM" "$REPO_BRANCH"
  done
}

# ---------------------------------------------------------------------------

case "${1:-}" in
  add)    shift; cmd_add "$@" ;;
  delete) shift; cmd_delete "$@" ;;
  list)   shift; cmd_list "$@" ;;
  repos)  shift; cmd_repos "$@" ;;
  *)      usage ;;
esac
